{
  "Database": {
    "Provider": "sqlite"
  },
  "Registration": {
    "AllowPublic": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=QontractDb.sqlite"
  },
  "Storage": {
    "Provider": "local",
    "Path": "Storage",
    "MaxFileSizeBytes": 52428800,
    "Azure": {
      "ConnectionString": "",
      "ContainerName": "documents"
    },
    "S3": {
      "Bucket": "",
      "Prefix": "",
      "Region": ""
    }
  },
  "DocumentRetention": {
    "DefaultDays": 90,
    "CheckIntervalMinutes": 60
  },
  "Recommendations": {
    "Enabled": true,
    "CheckIntervalMinutes": 360,
    "DefaultTimeZone": "Europe/Berlin"
  },
  "Jwt": {
    "Issuer": "Qontract",
    "Audience": "QontractClients"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Auth": {
    "Sessions": {
      "AccessTokenMinutes": 15,
      "RefreshGraceSeconds": 30,
      "Web": { "IdleDays": 30, "AbsoluteDays": 90 },
      "Mobile": { "IdleDays": 90, "AbsoluteDays": 365 }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  }
}
