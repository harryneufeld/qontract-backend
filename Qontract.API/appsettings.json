{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=QontractDb.sqlite"
  },
  "Storage": {
    "Path": "Storage",
    "MaxFileSizeBytes": 52428800
  },
  "DocumentRetention": {
    "DefaultDays": 90,
    "CheckIntervalMinutes": 60
  },
  "Jwt": {
    "Issuer": "Qontract",
    "Audience": "QontractClients"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  }
}
