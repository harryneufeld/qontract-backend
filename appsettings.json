{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=QontractDb.sqlite"
  },
  "Storage": {
    "Path": "Storage"
  },
  "Jwt": {
    "Key": "your-256-bit-key-here-change-in-production",
