QONTRACT_RELEASE=production-REPLACE_WITH_COMMIT
API_PORT=5001
DATABASE_PROVIDER=REPLACE_WITH_CHOSEN_PROVIDER
WEB_ORIGIN=https://qontract.example.com
API_ALLOWED_HOSTS=api.example.com
PUBLIC_APP_URL=https://qontract.example.com/
TRUSTED_PROXY_IP=REPLACE_WITH_IMMEDIATE_PROXY_IP
QONTRACT_SECRETS_FILE=/opt/qontract/production/secrets/api.env
ALLOW_PUBLIC_REGISTRATION=false
PASSWORD_RESET_ENABLED=false
# Requires the password-reset SMTP and PasswordReset__PublicAppUrl settings.
REQUIRE_EMAIL_CONFIRMATION=false
# Leave empty to show no terms of use; set both to require acceptance at signup.
TERMS_VERSION=
TERMS_URL=
TRAEFIK_NETWORK=REPLACE_WITH_EXISTING_PROXY_NETWORK
TRAEFIK_ROUTER=qontract-production-api
TRAEFIK_HOST=api.example.com
TRAEFIK_HTTPS_ENTRYPOINT=REPLACE_WITH_HTTPS_ENTRYPOINT
TRAEFIK_CERT_RESOLVER=REPLACE_WITH_EXISTING_RESOLVER
