# Build context is the prebuilt Flutter build/web directory, with root base href.
# Assets can be compiled on another machine; nginx runs natively on ARM64/amd64.
FROM nginx:1.30-alpine
COPY . /usr/share/nginx/html/
RUN mkdir -p /usr/share/nginx/html/_spa \
    && cp /usr/share/nginx/html/index.html /usr/share/nginx/html/_spa/index.html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz > /dev/null || exit 1
