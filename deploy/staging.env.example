QONTRACT_RELEASE=staging-REPLACE_WITH_COMMIT
API_PORT=5000
DATABASE_PROVIDER=REPLACE_WITH_CHOSEN_PROVIDER
WEB_ORIGIN=https://staging.example.com
API_ALLOWED_HOSTS=api.staging.example.com
PUBLIC_APP_URL=https://staging.example.com/
TRUSTED_PROXY_IP=REPLACE_WITH_IMMEDIATE_PROXY_IP
QONTRACT_SECRETS_FILE=/opt/qontract/staging/secrets/api.env
ALLOW_PUBLIC_REGISTRATION=false
PASSWORD_RESET_ENABLED=false
TRAEFIK_NETWORK=REPLACE_WITH_EXISTING_PROXY_NETWORK
TRAEFIK_ROUTER=qontract-staging-api
TRAEFIK_HOST=api.staging.example.com
TRAEFIK_HTTPS_ENTRYPOINT=REPLACE_WITH_HTTPS_ENTRYPOINT
# Used only with deploy/compose.traefik-acme.yml:
TRAEFIK_CERT_RESOLVER=REPLACE_WITH_EXISTING_RESOLVER
