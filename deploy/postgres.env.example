# Copy OUTSIDE Git to the POSTGRES_SECRETS_FILE location, chmod 600, then edit.
# Generate a password with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
# The API's protected env file then uses the same password:
# ConnectionStrings__DefaultConnection=Host=qontract-postgres;Database=qontract;Username=qontract;Password=<same password>
