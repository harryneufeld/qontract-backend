# Copy privately; use a LAN address and free port. Never forward this port publicly.
STAGING_HOST=192.168.1.50
STAGING_BIND_IP=192.168.1.50
STAGING_HTTPS_PORT=8443
STAGING_NETWORK_SUBNET=172.30.88.0/24
STAGING_PROXY_IP=172.30.88.2
STAGING_DATA_PATH=/opt/qontract-staging/data
STAGING_DOCUMENTS_PATH=/opt/qontract-staging/documents
STAGING_WEB_CONFIG_PATH=/opt/qontract-staging/nginx.conf
STAGING_SECRETS_FILE=/opt/qontract-staging/secrets/api.env
QONTRACT_API_IMAGE=qontract-api:staging
QONTRACT_WEB_IMAGE=qontract-web:staging
TRAEFIK_IMAGE=traefik:v3.7.14
PASSWORD_RESET_ENABLED=false
