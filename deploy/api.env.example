# Copy outside the checkout and restrict permissions (chmod 600).
# Supply real secrets there; do not pass this example directly to Compose.
Jwt__Key=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Choose exactly one connection string, matching DATABASE_PROVIDER:
# SQLite (persistent /app/data volume):
# ConnectionStrings__DefaultConnection=Data Source=/app/data/QontractDb.sqlite
# PostgreSQL (separately backed-up, reachable database):
# ConnectionStrings__DefaultConnection=Host=DATABASE_HOST;Database=qontract;Username=qontract;Password=REPLACE
# SQL Server (separately backed-up, reachable database):
# ConnectionStrings__DefaultConnection=Server=DATABASE_HOST;Database=QontractDb;User Id=qontract;Password=REPLACE;Encrypt=True
ConnectionStrings__DefaultConnection=REPLACE_WITH_PROVIDER_MATCHING_CONNECTION_STRING
# Supply these only when enabling password reset:
Smtp__Host=REPLACE_WITH_SMTP_HOST
Smtp__Port=587
Smtp__TlsMode=StartTls
Smtp__From=REPLACE_WITH_SENDER
Smtp__Username=REPLACE_WITH_SMTP_USERNAME
Smtp__Password=REPLACE_WITH_SMTP_PASSWORD
