# Copy to deploy/traefik-cifs.env and replace these examples.
# Set after the first successful master workflow publishes this image.
# Prefer ghcr.io/harryneufeld/qontract-backend@sha256:... from its job summary.
QONTRACT_IMAGE=ghcr.io/harryneufeld/qontract-backend:master
QONTRACT_ENVIRONMENT=Staging
QONTRACT_SECRETS_FILE=/opt/qontract/staging/secrets/api.env

# SQLite uses a local Docker volume. Do not store its database on CIFS.
# PostgreSQL/SQL Server are supported when provisioned separately; change the
# provider AND the connection string in api.env together.
DATABASE_PROVIDER=sqlite

API_HOST=api.qontract-staging.example.com
WEB_ORIGIN=https://qontract-staging.example.com
PUBLIC_APP_URL=https://qontract-staging.example.com/
TRAEFIK_NETWORK=traefik
TRAEFIK_ROUTER=qontract-staging-api
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Example only: replace with Traefik's actual stable address on this network.
TRUSTED_PROXY_IP=172.20.0.2

# Existing Linux-host CIFS mount, with a dedicated staging document subfolder.
DOCUMENTS_HOST_PATH=/mnt/nas/qontract-staging/documents
ALLOW_PUBLIC_REGISTRATION=false
PASSWORD_RESET_ENABLED=false
# Requires the password-reset SMTP and PasswordReset__PublicAppUrl settings.
REQUIRE_EMAIL_CONFIRMATION=false
# Leave empty to show no terms of use; set both to require acceptance at signup.
TERMS_VERSION=
TERMS_URL=
